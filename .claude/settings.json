{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only origin develop:*)",
      "Bash(git add:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(git switch -c:*)",
      "Bash(git checkout -b:*)",
      "Bash(git worktree add:*)",
      "Bash(git branch -D:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(git push --force:*)",
      "Bash(npm publish:*)",
      "Bash(uv publish:*)",
      "Bash(aws * create-*)",
      "Bash(aws * delete-*)",
      "Bash(aws * put-*)",
      "Bash(aws * update-*)",
      "Bash(aws * modify-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws * start-*)",
      "Bash(aws * stop-*)",
      "Bash(aws * attach-*)",
      "Bash(aws * detach-*)",
      "Bash(aws * tag-*)",
      "Bash(aws * untag-*)",
      "Bash(aws s3 cp *)",
      "Bash(aws s3 mv *)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 sync *)",
      "Bash(aws cloudformation deploy *)",
      "Bash(aws * run-instances *)",
      "Bash(aws ssm send-command *)",
      "Bash(aws ssm start-session *)",
      "Bash(aws lambda invoke *)",
      "Bash(aws * authorize-*)",
      "Bash(aws * revoke-*)",
      "Bash(aws * reboot-*)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3api put-*)",
      "Bash(az * create*)",
      "Bash(az * delete*)",
      "Bash(az * update*)",
      "Bash(az * start*)",
      "Bash(az * stop*)",
      "Bash(az * restart*)",
      "Bash(az * deallocate*)",
      "Bash(az * assign*)",
      "Bash(az * add*)",
      "Bash(az * remove*)",
      "Bash(az * import*)",
      "Bash(az * invoke*)",
      "Bash(az rest *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.secrets)"
    ]
  }
}
