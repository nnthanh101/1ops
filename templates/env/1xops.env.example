# 1xops settings for one tenant. Non-secret values only: sign-ins stay in AWS SSO, az login and the Atlassian sign-in.
# Copy this file into the tenant's folder as .env.1xops, then replace every $TENANT value. `1xops setup` writes the same layout.
ONEXOPS_SCOPE=team  # who the settings are for: org, team, local or personal
ONEXOPS_DIR=.  # this tenant's folder
ONEXOPS_CONNECTORS=aws,azure,itsm  # the connectors this tenant uses
AWS_CONFIG_FILE=~/.aws/tenants/$TENANT/config  # this tenant's own AWS config file
AWS_BILLING_PROFILE=$TENANT-BillingReadOnlyAccess  # read-only AWS sign-in for cost and savings questions
AWS_OPERATIONS_PROFILE=$TENANT-ReadOnlyAccess  # read-only AWS sign-in for audit, monitoring and security review
AWS_REGION=ap-southeast-2  # where this tenant's workloads run
AZURE_CONFIG_DIR=~/.azure-$TENANT  # this tenant's Reader identity folder
AZURE_TENANT_ID=$TENANT-tenant-guid  # the Azure tenant of the Reader identity
AZURE_SUBSCRIPTION_ID=$TENANT-subscription-guid  # the Azure subscription to read
# Connectors this tenant does not use, for example the Gmail and Calendar placeholders:
# ONEXOPS_IGNORE=gmail,google calendar
