#!/usr/bin/env bash
# pre-push: every branch except develop and main is proven locally before it reaches GitHub, because GitHub Actions
# runs only for develop and main. It runs the tests of the Release workflow with act, and builds the image act cannot build.
# Advice only: it names what failed and how to rerun it, then lets the push go ahead. The person decides.
# Turned on per clone by `git config core.hooksPath .githooks`. `bash .githooks/pre-push --self-test` proves it.
set -uo pipefail
unset GIT_DIR GIT_WORK_TREE

needs_local_ci() { # <branch>: 0 when the branch is checked locally (everything except develop and main)
  case "$1" in develop|main|"") return 1 ;; *) return 0 ;; esac
}

if [ "${1:-}" = --self-test ]; then
  ok=0
  needs_local_ci feature/x && ok=$((ok + 1)) || echo "  [FAIL] feature/x must be checked locally"
  needs_local_ci develop || ok=$((ok + 1))
  needs_local_ci main || ok=$((ok + 1))
  [ "$ok" = 3 ] || echo "  [FAIL] develop and main are checked by GitHub, not by this hook"
  echo "pre-push self-test: $ok/3 cases as expected"; [ "$ok" = 3 ]; exit $?
fi

# Advice for everyone, never a blocker: the owner decides. Switch it off for this clone with
# `git config git-standard.advice off`; back on with `git config --unset git-standard.advice`.
[ "$(git config --get git-standard.advice 2>/dev/null)" = off ] && exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
# The branches being pushed, from the refs git passes on stdin; the checked-out branch when there are none.
branch=""
if [ -t 0 ]; then branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
else
  while read -r _ _ remote_ref _; do
    b=${remote_ref#refs/heads/}
    [ "$b" != "$remote_ref" ] && needs_local_ci "$b" && branch="${branch:+$branch }$b"
  done
fi
[ -n "$branch" ] && needs_local_ci "${branch%% *}" || exit 0
command -v act >/dev/null 2>&1 && docker info >/dev/null 2>&1 || {
  echo "pre-push: advice - $branch was not checked locally: act and a running Docker are needed (brew install act; start Docker). The push goes ahead."; exit 0; }

echo "pre-push: checking $branch locally, as this folder is now (act: the Release workflow's tests, then the image)"
log=$(mktemp); trap 'rm -f "$log"' EXIT
if ! (cd "$root" && act pull_request -W .github/workflows/release.yml --rm >"$log" 2>&1); then
  grep -E "Job (succeeded|failed)|❌|::error" "$log" | tail -12
  echo "pre-push: advice - the tests failed locally; the push goes ahead. Rerun: act pull_request -W .github/workflows/release.yml"
  exit 0
fi
grep -E "Job succeeded" "$log" | sort -u
(cd "$root" && docker build -q --build-context repo=. -t 1xops:pre-push packages/python >/dev/null && docker run --rm 1xops:pre-push --version) || {
  echo "pre-push: advice - the image did not build or run; the push goes ahead"; exit 0; }
echo "pre-push: $branch passed locally"
