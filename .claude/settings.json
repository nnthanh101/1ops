    "aws-continuum@agent-toolkit-for-aws": true,
    "shopify-plugin@shopify-ai-toolkit": true,
    "vercel-plugin@vercel": true,
    "terraform@hashicorp": true,
    "superpowers@superpowers-dev": true,
    "design@knowledge-work-plugins": true,
    "legal@knowledge-work-plugins": true,
    "productivity@knowledge-work-plugins": true,
    "claude-code-setup@claude-plugins-official": true,
