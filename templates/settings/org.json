    {
      "serverName": "awslabs-cloudtrail"
    },
    {
      "serverName": "awslabs-cloudwatch"
    },
    {
      "serverName": "awslabs-well-architected-security"
    },
    {
      "serverName": "azure"
    },
    {
      "serverName": "atlassian"
